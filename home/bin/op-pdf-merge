#!/usr/bin/env bash

OUTFILE=$1
shift

gs -q \
	   -dNOPAUSE \
	   -dBATCH \
	   -dSAFER \
	   -sDEVICE=pdfwrite \
	   -dCompatibilityLevel=1.3 \
	   -dPDFSETTINGS=/screen \
	   -dEmbedAllFonts=true \
	   -dSubsetFonts=true \
	   -dColorImageDownsampleType=/Bicubic \
	   -dColorImageResolution=144 \
	   -dGrayImageDownsampleType=/Bicubic \
	   -dGrayImageResolution=144 \
	   -dMonoImageDownsampleType=/Bicubic \
	   -dMonoImageResolution=144 \
	   -dCompressFonts=true \
	   -sOutputFile=${OUTFILE} ${*}
