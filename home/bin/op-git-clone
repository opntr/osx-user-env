#!/usr/bin/env bash

GIT_WORKSPACE=${HOME}/data/git

if [ -z "${1}" ]
then
	echo "fuck"
	exit 1
fi

if [ "$(git config submodule.recurse)" != "true" ]
then
	git config --global submodule.recurse true
fi

URL="${1}"

# git@github.com:opntr-bborg/osx-user-env.git
# ssh://anongit@git.FreeBSD.org/src.git
META=$(echo ${URL} | sed -n \
			-e '/anongit@/s#^.*://anongit@\(.*\)/\(.*\).git$#SERVER=\1\nNAMESPACE=freebsd\nREPO=\2#gp' \
			-e '/git@/s#^.*://git@\(.*\)/\(.*\)/\(.*\).git$#SERVER=\1\nNAMESPACE=\2\nREPO=\3#gp' \
			-e '/git@/s#^git@\(.*\):\(.*\)/\(.*\).git$#SERVER=\1\nNAMESPACE=\2\nREPO=\3#gp' \
			-e 's#^.*://\(.*\)/\(.*\)/\(.*\).git$#SERVER=\1\nNAMESPACE=\2\nREPO=\3#gp' \
	)

eval ${META}
printf "server: ${SERVER}\nnamespace: ${NAMESPACE}\nrepo: ${REPO}\n"

if [ -z "${SERVER}" -o -z "${NAMESPACE}" -o -z "${REPO}" ]
then
	echo "fuck"
	exit 2
fi

mkdir -p ${GIT_WORKSPACE}/${SERVER}/${NAMESPACE}

pushd ${GIT_WORKSPACE}/${SERVER}/${NAMESPACE}
git clone --recursive ${URL}
pushd ${REPO}
git lfs checkout
popd
popd

# invalidate ws_select caches after the git clone
for i in ${HOME}/.cache/ws_select-*.cache
do
	unlink ${i}
done

printf "\n\nthe new git repo will be in the following directory:\n${GIT_WORKSPACE}/${SERVER}/${NAMESPACE}/${REPO}\n"
