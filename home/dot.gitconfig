[submodule]
	recurse = true
[user]
	name = Oliver Pinter
	email = oliver.pntr@gmail.com
[push]
        default = simple
[commit]
        template = ~/.git/commit-template
[alias]
        log-with-tree = log --decorate --all --graph
        logd = log --decorate
        tree = log --oneline --decorate --all --graph
[init]
        defaultBranch = master
